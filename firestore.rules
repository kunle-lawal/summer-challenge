rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Slug index — one doc per slug, contains only challengeId
    // -------------------------------------------------------------------------
    match /slugIndex/{slug} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['challengeId'])
        && request.resource.data.challengeId is string
        && request.resource.data.challengeId.size() > 0;
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Challenges + subcollections
    // -------------------------------------------------------------------------
    match /challenges/{challengeId} {
      allow read: if true;
      allow create: if isValidChallenge(request.resource.data);
      allow update: if isValidChallenge(request.resource.data);
      allow delete: if false;

      // Members
      match /members/{memberId} {
        allow read: if true;
        allow create, update: if isValidMember(request.resource.data);
        allow delete: if false;
      }

      // Entries
      match /entries/{entryId} {
        allow read: if true;
        allow create, update: if isValidEntry(request.resource.data);
        allow delete: if false;
      }

      // Audit log — append-only; no updates or deletes ever
      match /auditLog/{logId} {
        allow read: if true;
        allow create: if isValidAuditLog(request.resource.data);
        allow update, delete: if false;
      }
    }

    // =========================================================================
    // Shape validators
    // =========================================================================

    function isValidChallenge(d) {
      return d.keys().hasAll([
          'slug', 'name', 'createdAt', 'status',
          'ownerPasswordHash', 'ownerPasswordSalt', 'config'
        ])
        && d.slug is string && d.slug.size() > 0
        && d.name is string && d.name.size() > 0
        && d.status in ['active', 'ended']
        && d.ownerPasswordHash is string
        && d.ownerPasswordSalt is string
        && d.config is map
        && d.config.keys().hasAll(['startDate', 'weekAnchor', 'timezone', 'rules'])
        && d.config.startDate is string
        && d.config.weekAnchor is string
        && d.config.timezone is string
        && d.config.rules is list;
    }

    function isValidMember(d) {
      return d.keys().hasAll(['name', 'createdAt', 'active', 'removedAt'])
        && d.name is string && d.name.size() > 0
        && d.active is bool
        && (d.removedAt == null || d.removedAt is timestamp);
    }

    function isValidEntry(d) {
      return d.keys().hasAll([
          'memberId', 'date', 'values', 'pts',
          'createdAt', 'updatedAt', 'createdByMemberId'
        ])
        && d.memberId is string
        && d.date is string && d.date.size() == 10
        && d.values is map
        && d.pts is number
        && (d.createdByMemberId == null || d.createdByMemberId is string);
    }

    function isValidAuditLog(d) {
      return d.keys().hasAll(['timestamp', 'actorIsOwner', 'action', 'target'])
        && d.actorIsOwner is bool
        && d.action is string
        && d.target is map
        && d.target.keys().hasAll(['kind', 'id'])
        && d.target.kind in ['challenge', 'member', 'entry'];
    }
  }
}
